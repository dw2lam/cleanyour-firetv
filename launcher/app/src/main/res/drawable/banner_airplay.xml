<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for the AirPlay receiver tile (config.xml, app_banners): a graphite field with a large AirPlay glyph.
     Amazon's own banner for it is black with the word "AirPlay" in small type. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF3A3A3C" android:endColor="#FF1C1C1E" />
        </shape>
    </item>
    <item android:width="124dp" android:height="124dp" android:gravity="center"
        android:drawable="@drawable/ic_airplay" />
</layer-list>
